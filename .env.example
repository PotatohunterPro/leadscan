# LeadScan — variáveis de ambiente (copiar para .env e preencher)
PORT=8000
OLLAMA_MODEL=hf.co/LiquidAI/LFM2.5-VL-450M-Extract-GGUF:F16
WHATSAPP_DEFAULT_DDI=55
DOMAIN=hublead.pradodacostasolucoes.com.br
ADMIN_PASSWORD_HASH=
#   Obs.: o hash bcrypt contém "$" — o install.sh normaliza pra "$" automaticamente
#   gerar com: python3 -c "import bcrypt; print(bcrypt.hashpw(b'SUA_SENHA', bcrypt.gensalt()).decode())"
SESSION_SECRET=
#   string aleatória longa — gerar com: openssl rand -hex 32
CERTBOT_EMAIL=
#   e-mail do Let's Encrypt (se preenchido, o install.sh emite o certificado HTTPS sozinho)
